<Window x:Class="WpfMvvmApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfMvvmApp.ViewModels"
        xmlns:conv="clr-namespace:WpfMvvmApp.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="900" Width="1200"
        MinHeight="640" MinWidth="940">
        Title="{Binding Title}" Height="860" Width="1200"
        MinHeight="620" MinWidth="940">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style x:Key="FieldCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#FFDDE2EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                    <Setter Property="Background" Value="#FFFFF8E1" />
                    <Setter Property="BorderBrush" Value="#FFF3C669" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="Document Type:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="280"
                      ItemsSource="{Binding DocumentTypes}"
                      SelectedItem="{Binding SelectedDocumentType}"
                      DisplayMemberPath="Name" />
        </DockPanel>

        <Border Grid.Row="2" BorderBrush="#FFCAD0DA" BorderThickness="1" CornerRadius="8" Background="#FFF7F9FC" Padding="10">
            <Grid>
                <Image Source="{Binding FormImageUri}" Stretch="Uniform" />
                <TextBlock Text="Place source image in Data folder and set imagePath in selected DocDef JSON"
        <Border Grid.Row="0" BorderBrush="#FFCAD0DA" BorderThickness="1" CornerRadius="8" Background="#FFF7F9FC" Padding="10">
            <Grid>
                <Image Source="{Binding FormImageUri}" Stretch="Uniform" />
                <TextBlock Text="Place source image at Data/sample-burial-register.jpg"
                           Foreground="#99000000"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontStyle="Italic"
                           Visibility="{Binding FormImageUri, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
            </Grid>
        </Border>

        <Border Grid.Row="4" BorderBrush="#FFCAD0DA" BorderThickness="1" CornerRadius="8" Padding="12">
        <Border Grid.Row="2" BorderBrush="#FFCAD0DA" BorderThickness="1" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource FieldCardStyle}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                                            <TextBlock Text="{Binding ConfidenceLabel}"
                                                                       DockPanel.Dock="Right"
                                                                       FontSize="10"
                                                                       Foreground="#FF9A6A00"
                                                                       Visibility="{Binding IsLowConfidence, Converter={StaticResource BoolToVisibility}}" />
                                                        </DockPanel>
                                                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                                        <DatePicker SelectedDate="{Binding DateValue}"
                                                                    Visibility="{Binding IsDate, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 Height="70"
                                                                 TextWrapping="Wrap"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 Visibility="{Binding IsMultiline, Converter={StaticResource BoolToVisibility}}" />
                                                        <CheckBox Content="Confirmed"
                                                                  IsChecked="{Binding BoolValue}"
                                                                  Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding TableSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,12">
                                    <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

                                    <Border BorderBrush="#FFCFD8E6" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <Border Background="#FFF4F6FA" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Entry" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Headers}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="{Binding ColumnCount}" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#FFE6EBF2" BorderThickness="0,1,0,0" Padding="8,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding EntryNo}" VerticalAlignment="Center" FontWeight="SemiBold" />

                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Columns="{Binding ColumnCount}" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Margin="0,0,10,0">
                                                                                <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                                                         Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                                                                <DatePicker SelectedDate="{Binding DateValue}"
                                                                                            Visibility="{Binding IsDate, Converter={StaticResource BoolToVisibility}}" />
                                                                                <CheckBox Content="True/False"
                                                                                          IsChecked="{Binding BoolValue}"
                                                                                          Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisibility}}" />
                                                                                <TextBlock Text="{Binding ConfidenceLabel}"
                                                                                           FontSize="10"
                                                                                           Foreground="#FF9A6A00"
                                                                                           Visibility="{Binding IsLowConfidence, Converter={StaticResource BoolToVisibility}}" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
